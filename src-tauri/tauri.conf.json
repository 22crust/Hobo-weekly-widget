{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Planner",
  "version": "1.1.0",
  "identifier": "com.localplanner.desktop",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "planner-widget",
        "title": "Weekly Planner",
        "url": "index.html?window=planner",
        "width": 760,
        "height": 760,
        "minWidth": 620,
        "minHeight": 500,
        "x": 450,
        "y": 100,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQTgzQ0NCMEI1RkNDMzAKUldRd3pGOEx5enlvMjVSOTIvSVBjemRBSEprWmZnTEVHdWFaVk5vRnNUUzIyL0F4V2c2YTZyZmcK",
      "endpoints": [
        "https://github.com/22crust/Hobo-weekly-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
